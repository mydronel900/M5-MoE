# ==============================================================================
# M5 Local MoE Studio — Environment Configuration (.env)
# Copy this file to `.env` for local MacBook Air M5 usage:
#   cp .env.example .env
# ==============================================================================

# Web Studio & LAN Host Server (Express + Vite)
PORT="3000"
HOST="0.0.0.0"

# Apple Silicon M5 Python Worker (MLX + PyTorch MPS)
M5_MLX_WORKER_HOST="127.0.0.1"
M5_MLX_WORKER_PORT="8787"
M5_MLX_WORKER_URL="http://127.0.0.1:8787"

# Idle Auto-Unload Watchdog (seconds before freeing Metal/MPS wired RAM; 0 disables)
IDLE_UNLOAD_SECONDS="300"

# Default Local Output Folder for PNG images, MP4 videos, and Remix metadata
M5_OUTPUT_DIR="~/M5-MoE-Outputs"

# Optional External Local Inference Backends
OLLAMA_URL="http://127.0.0.1:11434"
OPENAI_LOCAL_URL="http://127.0.0.1:8080"
A1111_URL="http://127.0.0.1:7860"
COMFYUI_URL="http://127.0.0.1:8188"

# Optional Cloud Preview (only needed if using Cloud Preview mode for Chat/Prompt)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL injected automatically by AI Studio runtime.
APP_URL="MY_APP_URL"
